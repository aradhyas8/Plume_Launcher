<?xml version="1.0" encoding="utf-8"?>
<!-- Cue's body: the pill at rest and the open tile. Home holds it in @id/cue (glass); CueOverlay
     inflates it over other apps. Both draw it with cueBind and cueShape (CueViews.kt). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">
        <!-- Open, with more than one thing on Cue: a mark for each, Left and Right pick which one shows. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:focusable="false"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/cueChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Open, a camera alert with Full privacy: its snapshot, wide, above the text. -->
        <ImageView
            android:id="@+id/cuePhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/cueTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cueArt"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:id="@+id/cueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cueTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2dp"
                    android:maxWidth="260dp"
                    android:maxLines="1"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/cueArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.8"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:visibility="gone" />
                <!-- Under the text: the progress (a thin line at rest), then the buttons while open. -->
                <LinearLayout
                    android:id="@+id/cueMore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/cueTimes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/cueElapsed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.85"
                            android:fontFamily="sans-serif"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:minWidth="30dp"
                            android:textSize="12sp" />

                        <dev.plume.CueBar
                            android:id="@+id/cueProgress"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/cueLeft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.85"
                            android:fontFamily="sans-serif"
                            android:fontFeatureSettings="tnum"
                            android:gravity="end"
                            android:includeFontPadding="false"
                            android:minWidth="30dp"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- The open item's buttons, made for each item. -->
                    <LinearLayout
                        android:id="@+id/cueActions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp"
                        android:clipChildren="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>

            <!-- A second picture at the end: the home team's logo. -->
            <ImageView
                android:id="@+id/cueArt2"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="10dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <dev.plume.EqBars
                android:id="@+id/cueEq"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="12dp" />

            <!-- The playing app's mark, as the Shows row shows it. Only while open. -->
            <ImageView
                android:id="@+id/cueApp"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>
</merge>
