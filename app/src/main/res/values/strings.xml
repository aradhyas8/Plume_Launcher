    <string name="auto_note_sun">Auto is light from sunrise to sunset in %1$s. Today: %2$s to %3$s.</string>
    <string name="auto_note_up">Auto stays light today: the sun does not set in %1$s.</string>
    <string name="auto_note_down">Auto stays dark today: the sun does not rise in %1$s.</string>
    <string name="auto_note_clock">Auto is light from %1$s to %2$s. Set a location in Clock &amp; weather to follow sunrise and sunset.</string>
