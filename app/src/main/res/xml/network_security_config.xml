<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <!-- Apple's aerial CDN uses a root certificate that this Android TV does not include. -->
    <domain-config>
        <domain includeSubdomains="false">sylvan.apple.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/apple_root_ca" />
        </trust-anchors>
    </domain-config>
</network-security-config>
